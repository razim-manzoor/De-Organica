# De Organica LLC Environment Configuration

# Resend API Key for dispatching inquiry emails with CV attachments to deorganicallc@gmail.com
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Verified domain sender address in Resend.
# TIP: Use a dedicated subdomain (e.g. send.deorganica.am) so Resend bounce MX/SPF DNS records
# never conflict with Google Workspace MX/SPF records on your root domain deorganica.am.
RESEND_FROM_EMAIL=inquiries@send.deorganica.am

# Sanity Headless CMS Configuration (optional during initial static deployment; enables /studio and live CMS reads when set)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-11-01
# Server-side token with Viewer access for Draft Mode preview and private reads
SANITY_API_READ_TOKEN=
# Shared secret between Sanity webhooks and POST /api/revalidate
SANITY_REVALIDATE_SECRET=
# Optional write token used only by npm run sanity:seed to import initial content & media assets
SANITY_API_WRITE_TOKEN=

